# Copie para .env e preencha com valores reais. NUNCA versione o .env real.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Gere um valor forte, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3333
NODE_ENV=development

# Lista separada por vírgula das origens web permitidas. Vazio = aberto (só dev).
CORS_ORIGIN=

# Opcional: override da chave do freeimage.host
FREEIMAGE_API_KEY=
